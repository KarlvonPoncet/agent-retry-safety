# Python bytecode and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Experiment output (source-controlled fixtures can use tests/fixtures/)
results/
*.jsonl
retry-results*.json
retry-results*.csv

# The paper's committed artifacts are reproducibility fixtures, not scratch output.
!paper/artifacts/
!paper/artifacts/**

# Editors and OS files
.vscode/
.idea/
.DS_Store
*.swp
